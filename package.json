{
  "name": "dsh-memory-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes-style long-term memory for DeepSeek Harness: two plain-text stores, one memory tool, frozen prompt snapshot.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sync": "node scripts/sync-to-profile.mjs"
  },
  "main": "index.js"
}
